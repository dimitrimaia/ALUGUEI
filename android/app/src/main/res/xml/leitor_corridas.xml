<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuração do leitor de corridas (LeitorCorridasService).
    packageNames vem de @string/pacotes_corridas (res/values/plantao.xml): a lista fica num lugar só.
    Sem flagRequestTouchExplorationMode, sem gestos, sem ações: só lê o texto da tela desses apps.
    flagRetrieveInteractiveWindows: para achar a janela do app de corrida quando ela não é a
    ativa (ex.: oferta do inDrive por cima da tela bloqueada). Continua só lendo.
    flagIncludeNotImportantViews: a Uber marca parte do cartão da oferta como "não importante"
    para leitores de tela; sem isso o valor e os km não aparecem para o leitor.
    canTakeScreenshot: só para o "print das ofertas" (opcional, Android 11+, desligado por padrão).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="1000"
    android:packageNames="@string/pacotes_corridas"
    android:description="@string/leitor_descricao" />

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Plantão: serviço em primeiro plano que desenha a bolha e o cartão por cima
            do app de corrida. Tipo specialUse (nenhum tipo padrão do Android cobre isso).
        -->
        <service
            android:name=".plantao.BolhaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mostrar o cálculo de ganho da corrida por cima do app de corrida, a pedido do motorista" />
        </service>

        <!--
            Leitor de corridas: serviço de acessibilidade que só lê valor, distância e
            tempo das ofertas da Uber, 99 e inDrive. Não executa ações nos outros apps.
            Só o sistema pode ligá-lo (BIND_ACCESSIBILITY_SERVICE).
        -->
        <service
            android:name=".plantao.LeitorCorridasService"
            android:exported="false"
            android:label="@string/leitor_nome"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/leitor_corridas" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissões (o porquê de cada uma está em docs/app-nativo.md) -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Desenhar a bolha e o cartão por cima do app de corrida. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Manter o plantão ligado em primeiro plano, com a notificação fixa. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Mostrar a notificação "Plantão ligado" (Android 13+ pede ao usuário). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pedir para o Android não suspender o plantão durante a jornada. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

</manifest>

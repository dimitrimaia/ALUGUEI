<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Plantão: serviço em primeiro plano que desenha a bolha e o cartão por cima
            do app de corrida. Tipo specialUse (nenhum tipo padrão do Android cobre isso)
            e, só quando o motorista permite a localização, também location (para
            calcular a volta do destino até a base).
        -->
        <service
            android:name=".plantao.BolhaService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mostrar o cálculo de ganho da corrida por cima do app de corrida, a pedido do motorista" />
        </service>

        <!--
            Copiloto (leitor de corridas): serviço de acessibilidade que só lê as ofertas
            da Uber, 99 e inDrive. Não executa ações nem gestos nos outros apps.
            Só o sistema pode ligá-lo (BIND_ACCESSIBILITY_SERVICE).
        -->
        <service
            android:name=".plantao.LeitorCorridasService"
            android:exported="false"
            android:label="@string/leitor_nome"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/leitor_corridas" />
        </service>

        <!--
            Câmera de segurança da corrida: grava em arquivos no próprio celular
            (Movies/Aluguei/Corridas), com a notificação fixa "Câmera de segurança
            gravando" e o botão Parar. Só começa com o Aluguei aberto. Microfone só
            quando o motorista deu a permissão.
        -->
        <service
            android:name=".plantao.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Baixa o modelo de leitura de imagem (ML Kit) junto com a instalação. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissões (o porquê de cada uma está em docs/app-nativo.md) -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Desenhar a bolha e o cartão por cima do app de corrida. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Manter o plantão ligado em primeiro plano, com a notificação fixa. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Mostrar a notificação "Copiloto ligado" (Android 13+ pede ao usuário). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibração curta quando o cartão aparece (verde 1 pulso, vermelho 2); dá para desligar. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Volta para a base e "Definir base aqui" (só no momento da oferta; não guarda trajeto). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- A localização é opcional: o app instala em aparelhos sem GPS. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- Pedir para o Android não suspender o Copiloto durante a jornada. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Câmera de segurança (opcional): vídeo da corrida só no celular; áudio só com a permissão do microfone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Voz do Copiloto (TextToSpeech): o Android 11+ só mostra o motor de voz com esta consulta. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Botões Embarque/Destino: saber se o Google Maps ou o Waze estão instalados (senão, o mapa padrão). -->
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

</manifest>

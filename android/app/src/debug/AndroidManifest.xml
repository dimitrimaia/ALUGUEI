<?xml version="1.0" encoding="utf-8"?>
<!--
    Só no APK direto (build debug, baixado fora da Play Store): permite o "Atualizar
    o Copiloto" de dentro do app. A versão da Play Store (release/AAB) não tem esta
    permissão; lá quem atualiza é a própria loja.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>

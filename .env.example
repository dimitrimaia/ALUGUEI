# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# Supabase (projeto na região sa-east-1 / São Paulo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Senha com caracteres especiais precisa ser codificada (& → %26, + → %2B).
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Asaas (use o sandbox até o piloto). A chave pode ir com ou sem o $ inicial.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WALLET_ID_PLATAFORMA=
ASAAS_WEBHOOK_TOKEN=

# Cifra das chaves das subcontas (openssl rand -hex 32). Não troque depois de criada.
CHAVE_CIFRA=
# Segredo da rotina diária da Vercel Cron.
CRON_SECRET=

# ZapSign
ZAPSIGN_API_URL=https://sandbox.api.zapsign.com.br/api/v1
ZAPSIGN_API_TOKEN=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
